# copy to .env  ->  cp .env.example .env

# used by docker compose to create the postgres container
POSTGRES_USER=tasks
POSTGRES_PASSWORD=tasks
POSTGRES_DB=tasks

# used by the app when run with `npm start` on the host (outside docker).
# inside docker compose this is overridden to point at the `db` service.
DATABASE_URL=postgres://tasks:tasks@localhost:5432/tasks
REDIS_URL=redis://localhost:6379

PORT=3000
