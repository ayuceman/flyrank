# copy to .env   ->   cp .env.example .env
#
# Ollama (local, no key):
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma3:1b
#
# OpenRouter (hosted, free tier) - swap the three lines above for:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your_openrouter_key
# LLM_MODEL=openrouter/free

# operations
LLM_ENABLED=true        # false = kill switch, endpoint returns a fallback and never calls the model
LLM_STUB=0              # 1 = return a canned schema-valid answer, no model call (for dev)
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=3
PORT=3000
